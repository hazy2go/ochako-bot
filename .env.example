# ============================================================================
# OCHAKO BOT - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# ============================================================================

# ============================================================================
# API KEYS & AUTHENTICATION
# ============================================================================

# OpenAI API Key for AI conversation features
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# ============================================================================
# CHANNEL IDs
# ============================================================================
# Right-click on channels in Discord (with Developer Mode enabled) to copy IDs

# Channel where users post tweet links for raids
TWEET_CHANNEL_ID=1234567890123456789

# Forum channel for creating raid threads
FORUM_CHANNEL_ID=1234567890123456789

# Staff channel for approvals and notifications
STAFF_CHANNEL_ID=1234567890123456789

# Main mochi shop channel
MOCHI_SHOP_CHANNEL=1234567890123456789

# Equipment shop channel
EQUIPMENT_SHOP_CHANNEL=1234567890123456789

# Waterlily shop channel
WATERLILY_SHOP_CHANNEL=1234567890123456789

# General notifications channel
NOTIFICATION_CHANNEL=1234567890123456789

# Daily rewards channel
DAILY_REWARDS_CHANNEL=1234567890123456789

# Tea serving channel
TEA_CHANNEL_ID=1234567890123456789

# Channels where bot can randomly chat (comma-separated)
# Example: RANDOM_CHAT_CHANNELS=1234567890123456789,9876543210987654321
RANDOM_CHAT_CHANNELS=1234567890123456789,9876543210987654321

# ============================================================================
# ROLE IDs
# ============================================================================

# Role given when user receives tea
TEA_ROLE_ID=1234567890123456789

# Admin role for privileged commands
ADMIN_ROLE_ID=1234567890123456789

# ============================================================================
# GUILD (SERVER) ID
# ============================================================================

# Main Discord server/guild ID
GUILD_ID=1234567890123456789

# ============================================================================
# USER IDs
# ============================================================================

# (No user IDs required at this time)

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Bot command prefix (default: !)
# PREFIX=!

# ============================================================================
# NOTES
# ============================================================================
# - All IDs are 17-19 digit numbers (Discord Snowflakes)
# - Enable Developer Mode in Discord: Settings > Advanced > Developer Mode
# - Right-click channels/roles/users and select "Copy ID" to get their IDs
# - Keep your tokens and API keys secret and secure
# - The bot requires proper Discord permissions to function
# ============================================================================
